ROOT_FILE="/etc/security/rootasrole.json"
POLICY_DIR="/etc/security/rootasrole.d"
POLICY_FILE="$POLICY_DIR/default.json"

log() {
    echo "RootAsRole: $1"
}

# dosr needs its permitted capabilities, even if the package archive lost them
set_capabilities() {
    if ! setcap '=p' /usr/bin/dosr; then
        log "Failed to set the capabilities of /usr/bin/dosr, run: setcap '=p' /usr/bin/dosr"
    fi
}

post_install() {
    set_capabilities
    if [ -e "$ROOT_FILE" ]; then
        log "$ROOT_FILE already exists, the policy is left as it is."
        return 0
    fi

    # The administrator of the default policy: the user who ran pacman through sudo, or root.
    # Anything else than a plain user name falls back to root.
    admin="${SUDO_USER:-root}"
    case "$admin" in
        '' | *[!a-zA-Z0-9._-]*) admin=root ;;
    esac

    install -m 600 /usr/share/rootasrole/rootasrole.json "$ROOT_FILE"
    install -dm 700 "$POLICY_DIR"
    sed "s/\"ROOTADMINISTRATOR\"/\"$admin\"/" /usr/share/rootasrole/default.json > "$POLICY_FILE"
    chmod 600 "$POLICY_FILE"
    log "The default policy lets $admin run every command with dosr, and edit the policy with chsr."

    # dosr refuses a policy file without the immutable flag when the policy is immutable
    FS_TYPE=$(df -T "$POLICY_DIR" | awk 'NR==2 {print $2}')
    case "$FS_TYPE" in
        ext2 | ext3 | ext4 | xfs | btrfs | ocfs2 | jfs | reiserfs)
            if chattr +i "$ROOT_FILE" "$POLICY_FILE" && chattr +i "$POLICY_DIR"; then
                return 0
            fi
            log "Failed to set the immutable flag on the policy"
            chattr -i "$POLICY_DIR" "$POLICY_FILE" "$ROOT_FILE" 2>/dev/null
            ;;
        *)
            log "The file system $FS_TYPE does not support the immutable flag."
            ;;
    esac
    # without the flag, the policy is not declared immutable and no task needs to change it
    sed -i 's/"immutable": true/"immutable": false/' "$ROOT_FILE"
    sed -i 's;"CAP_LINUX_IMMUTABLE";;g' "$POLICY_FILE"
}

post_upgrade() {
    set_capabilities
    if [ -f "$ROOT_FILE" ] && ! chsr upgrade; then
        log "Some policy files could not be upgraded, check them with 'chsr upgrade --check'"
    fi
}
