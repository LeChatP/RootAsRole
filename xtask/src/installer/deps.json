{
  "targets": {
    "debian": {
      "aliases": ["ubuntu"],
      "query": "dpkg",
      "install": ["apt-get", "install"],
      "runtime": ["libpam0g", "libseccomp2"],
      "development": ["clang", "pkg-config", "libpam0g-dev", "libseccomp-dev", "pandoc"]
    },
    "fedora": {
      "aliases": ["rockylinux", "rocky", "centos", "almalinux", "rhel", "redhat"],
      "query": "rpm",
      "install": ["dnf", "install"],
      "runtime": ["pam", "libseccomp"],
      "development": ["clang", "pkgconfig", "pam-devel", "libseccomp-devel", "pandoc"]
    },
    "opensuse": {
      "aliases": ["suse"],
      "query": "rpm",
      "install": ["zypper", "install"],
      "runtime": ["pam", "libseccomp2"],
      "development": ["clang", "pkg-config", "pam-devel", "libseccomp-devel", "pandoc"]
    },
    "archlinux": {
      "aliases": ["arch"],
      "query": "pacman",
      "install": ["pacman", "-S", "--needed"],
      "runtime": ["pam", "libseccomp"],
      "development": ["clang", "pkgconf", "pam", "libseccomp", "pandoc-cli"]
    }
  }
}
