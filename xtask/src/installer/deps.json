{
  "targets": {
    "debian": {
      "aliases": ["ubuntu"],
      "query": "dpkg",
      "install": ["apt-get", "install"],
      "runtime": ["libpam0g", "libseccomp2"],
      "development": [["clang", "gcc"], "pkg-config", "libpam0g-dev", "libseccomp-dev"],
      "optional": [{ "package": "pandoc", "command": "pandoc", "for": "the manual pages" }]
    },
    "fedora": {
      "aliases": ["rockylinux", "rocky", "centos", "almalinux", "rhel", "redhat"],
      "query": "rpm",
      "install": ["dnf", "install"],
      "runtime": ["pam", "libseccomp"],
      "development": [["clang", "gcc"], "pkgconfig", "pam-devel", "libseccomp-devel"],
      "optional": [{ "package": "pandoc", "command": "pandoc", "for": "the manual pages" }]
    },
    "opensuse": {
      "aliases": ["suse"],
      "query": "rpm",
      "install": ["zypper", "install"],
      "runtime": ["pam", "libseccomp2"],
      "development": [["clang", "gcc"], "pkg-config", "pam-devel", "libseccomp-devel"],
      "optional": [{ "package": "pandoc", "command": "pandoc", "for": "the manual pages" }]
    },
    "archlinux": {
      "aliases": ["arch"],
      "query": "pacman",
      "install": ["pacman", "-S", "--needed"],
      "runtime": ["pam", "libseccomp"],
      "development": [["clang", "gcc"], "pkgconf", "pam", "libseccomp"],
      "optional": [{ "package": "pandoc-cli", "command": "pandoc", "for": "the manual pages" }]
    }
  }
}
